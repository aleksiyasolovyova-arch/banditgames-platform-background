### ============================================================
### 2. PUT /games/{favouriteGameId} - Update Game URLs
### ============================================================

### 2.1 Success - Update game URLs (200 OK)
PUT {{baseUrl}}/games/{{existingGameId}}
Content-Type: application/json

{
  "pictureUrl": "https://example.com/tictactoe-updated.png",
  "gameUrl": "https://example.com/play/tictactoe-v2"
}

### 2.2 Not Found - Game doesn't exist (404 Not Found)
PUT {{baseUrl}}/games/{{favouriteGameId}}
Content-Type: application/json

{
  "pictureUrl": "https://example.com/game.png",
  "gameUrl": "https://example.com/play"
}

### 2.3 Bad Request - Empty picture URL (400 Bad Request)
PUT {{baseUrl}}/games/{{existingGameId}}
Content-Type: application/json

{
  "pictureUrl": "",
  "gameUrl": "https://example.com/play"
}

### 2.4 Bad Request - Empty game URL (400 Bad Request)
PUT {{baseUrl}}/games/{{existingGameId}}
Content-Type: application/json

{
  "pictureUrl": "https://example.com/game.png",
  "gameUrl": ""
}

### 2.5 Bad Request - Null picture URL (400 Bad Request)
PUT {{baseUrl}}/games/{{existingGameId}}
Content-Type: application/json

{
  "pictureUrl": null,
  "gameUrl": "https://example.com/play"
}

### 2.6 Bad Request - Null game URL (400 Bad Request)
PUT {{baseUrl}}/games/{{existingGameId}}
Content-Type: application/json

{
  "pictureUrl": "https://example.com/game.png",
  "gameUrl": null
}

### ============================================================
### 3. PUT /games/{favouriteGameId}/accept - Accept Game
### ============================================================

### 3.1 Success - Accept pending game (200 OK)
PUT {{baseUrl}}/games/{{existingGameId}}/accept

### 3.2 Not Found - Game doesn't exist (404 Not Found)
PUT {{baseUrl}}/games/{{favouriteGameId}}/accept

### 3.3 Bad Request - Cannot accept already accepted game (400 Bad Request)
PUT {{baseUrl}}/games/{{existingGameId}}/accept

### 3.4 Bad Request - Cannot accept rejected game (400 Bad Request)
PUT {{baseUrl}}/games/{{existingGameId}}/accept

### ============================================================
### 4. PUT /games/{favouriteGameId}/reject - Reject Game
### ============================================================

### 4.1 Success - Reject pending game (200 OK)
PUT {{baseUrl}}/games/{{existingGameId}}/reject

### 4.2 Not Found - Game doesn't exist (404 Not Found)
PUT {{baseUrl}}/games/{{favouriteGameId}}/reject

### 4.3 Bad Request - Cannot reject already accepted game (400 Bad Request)
PUT {{baseUrl}}/games/{{existingGameId}}/reject

### 4.4 Bad Request - Cannot reject already rejected game (400 Bad Request)
PUT {{baseUrl}}/games/{{existingGameId}}/reject

###
GET http://localhost:8080/games

###
PUT {{baseUrl}}/games/9208f9e7-0ec2-4cfd-a56f-800613cdb3cd/toggle

