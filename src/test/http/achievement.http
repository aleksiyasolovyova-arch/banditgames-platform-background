  "achievementName": "First Victory",
  "description": "This is a very long description that exceeds the maximum allowed length of 255 characters. It contains additional text to ensure it goes well over the limit. The description should be concise and informative. When it exceeds the limit it should be rejected.",
  "pictureUrl": "https://example.com/badges/first-victory.png",
  "achievementType": "WIN_COUNT",
  "requiredValue": 1
}

